{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "${1:function_name}(${2:params}) -> ${3:i64} {",
      "\t$0",
      "}"
    ],
    "description": "KaniScript keyword-less function"
  },
  "Main Function": {
    "prefix": "main",
    "body": [
      "main() {",
      "\t$0",
      "}"
    ],
    "description": "KaniScript main entrypoint"
  },
  "When-Else Conditional": {
    "prefix": "when",
    "body": [
      "when ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "KaniScript when-else conditional"
  },
  "Each Loop": {
    "prefix": "each",
    "body": [
      "each ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "KaniScript each range loop"
  },
  "Short Assignment": {
    "prefix": ":=",
    "body": [
      "${1:name} := ${0:value}"
    ],
    "description": "KaniScript short variable declaration"
  },
  "Output Statement": {
    "prefix": "out",
    "body": [
      "out $0"
    ],
    "description": "KaniScript out print statement"
  }
}
