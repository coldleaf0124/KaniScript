{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KaniScript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kaniscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kaniscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kaniscript",
          "match": "\\b(when|else|each|in|while|return|out|struct)\\b"
        },
        {
          "name": "constant.language.boolean.kaniscript",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.kaniscript",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|void)\\b"
        },
        {
          "name": "entity.name.type.slice.kaniscript",
          "match": "\\[\\][a-zA-Z0-9_]+"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kaniscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kaniscript",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.kaniscript",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.kaniscript",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.kaniscript",
          "match": ":="
        },
        {
          "name": "keyword.operator.arrow.kaniscript",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.kaniscript",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.kaniscript",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.kaniscript",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.kaniscript",
          "match": "\\b(read_file|write_file|split|trim|parse_i64|parse_f64|time_now|len|int_to_str|float_to_str|perm_used|scratch_used)\\b"
        },
        {
          "name": "entity.name.function.kaniscript",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  },
  "scopeName": "source.kaniscript"
}
